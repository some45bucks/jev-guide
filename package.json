{
  "name": "jev-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that highlights the next thing to click to reach a goal on a website. The person does the clicking.",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
